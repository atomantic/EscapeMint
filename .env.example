# EscapeMint Environment Variables
# Copy to .env and customize as needed. All values have sensible defaults.

# Data directory for fund files (default: ./data)
# DATA_DIR=./data

# Backup directory (default: iCloud Documents/EscapeMint-Backups if available)
# BACKUP_DIR=

# API server port (default: 5551)
# PORT=5551

# Chrome DevTools Protocol port for browser scraping (default: 5549)
# CDP_PORT=5549

# CORS allowed origins, comma-separated (default: http://localhost:5550,http://localhost:5551)
# ALLOWED_ORIGINS=http://localhost:5550,http://localhost:5551

# Log level: debug, info, warn, error (default: info)
# LOG_LEVEL=info

# Node environment: development, production (default: development)
# NODE_ENV=development
